	partition EV_Locations = m
		mode: import
		source =
				let
				    源 = Parquet.Document(File.Contents("D:\mycode\nsw-ev-data-pipeline\data\silver\ev_sa4\ev_charging_locations_sa4_silver.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null]),
				    删除的其他列 = Table.SelectColumns(源,{"source", "station_name", "station_address", "operator_standardised", "number_of_plugs", "latitude", "longitude", "lga_name", "postcode", "charger_type", "is_upcoming", "charger_power_kw", "sa4_code", "sa4_name", "gcc_code", "gcc_name", "sa4_area_sqkm", "sa4_match_method", "sa4_match_distance_m"}),
				    更改的类型 = Table.TransformColumnTypes(删除的其他列,{{"source", type text}, {"station_name", type text}, {"station_address", type text}, {"operator_standardised", type text}, {"number_of_plugs", Int64.Type}, {"latitude", type number}, {"longitude", type number}, {"charger_power_kw", type number}, {"sa4_match_distance_m", type number}, {"sa4_area_sqkm", type number}, {"gcc_name", type text}, {"gcc_code", type text}, {"sa4_name", type text}, {"sa4_code", type text}, {"is_upcoming", type logical}, {"charger_type", type text}, {"postcode", type text}, {"lga_name", type text}, {"sa4_match_method", type text}})
