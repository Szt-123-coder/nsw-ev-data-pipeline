table EV_Locations
	lineageTag: ae8ab557-9d09-4250-8477-c89aa5fb3fd6

	measure 'Total Charging Locations' = COUNTROWS(EV_Locations)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: e0f11bc1-44e3-43c5-949a-6fcd7b4b9fd9

	measure 'Total Plugs' = SUM(EV_Locations[number_of_plugs])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 25695b3f-a394-4ab4-bfa6-3370f6598331

	measure 'Avg Plugs per Location' =
			DIVIDE(
			    [Total Plugs],
			    [Total Charging Locations]
			)
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: 986a2d8e-7664-4e24-ae0f-e8e16627de84

	measure 'Avg Charger Power (kW)' = AVERAGE(EV_Locations[charger_power_kw])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: cad0229b-c88a-4f7a-be5f-f41af3914400

	measure 'Max Charger Power (kW)' = MAX(EV_Locations[charger_power_kw])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: 865d629d-f89c-40b3-884b-7dece2505755

	measure 'Operator Count' =
			CALCULATE(
			    DISTINCTCOUNT(EV_Locations[operator_standardised]),
			    EV_Locations[operator_standardised] <> BLANK()
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 778f6342-a322-4c35-9e10-bf8718644d6c

	measure 'SA4 Count' = DISTINCTCOUNT(EV_Locations[sa4_code])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: cd6a8531-3320-4aba-9473-3c170bb875f7

	measure 'Existing Locations' =
			CALCULATE(
			    [Total Charging Locations],
			    EV_Locations[is_upcoming] = FALSE()
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: db3bd6d0-6797-4abf-86ea-d57d3cd00d17

	measure 'Upcoming Locations' =
			CALCULATE(
			    [Total Charging Locations],
			    EV_Locations[is_upcoming] = TRUE()
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c09398f4-1392-4474-8287-965419853d48

	measure 'AC Locations' =
			CALCULATE(
			    [Total Charging Locations],
			    EV_Locations[Charger Type Display] = "AC"
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: bc1f7ac7-d722-4b98-ab4c-bc8b0328a016

	measure 'DC Locations' =
			CALCULATE(
			    [Total Charging Locations],
			    EV_Locations[Charger Type Display] = "DC"
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: e0905734-5399-440c-ba32-6b0e643b9a18

	measure 'Resident Population' = CALCULATE(SUM(SA4_Summary[resident_population]), TREATAS(VALUES(GCC_Summary[gcc_code]), SA4_Summary[gcc_code]))
		formatString: #,0
		displayFolder: Population
		lineageTag: 24d7646f-54e4-4618-86ae-1bd555006e1f

	measure 'Existing Locations per 10,000 Residents' = DIVIDE([Existing Locations] * 10000, [Resident Population])
		formatString: 0.00
		displayFolder: Population
		lineageTag: 5b2505f7-a611-450e-b7e5-3dda357722bb

	measure 'Existing DC Locations per 10,000 Residents' = DIVIDE(CALCULATE([Existing Locations], KEEPFILTERS(EV_Locations[charger_type] = "DC")) * 10000, [Resident Population])
		formatString: 0.00
		displayFolder: Population
		lineageTag: f62c162d-6816-491b-8508-7a38abadb668

	measure 'Finding - Hunter DC Coverage' =
			VAR HunterDC = CALCULATE([Total Charging Locations], REMOVEFILTERS(), EV_Locations[is_upcoming] = FALSE(), EV_Locations[sa4_code] = "106", EV_Locations[charger_type] = "DC")
			VAR NSWDC = CALCULATE([Existing Locations], REMOVEFILTERS(), EV_Locations[charger_type] = "DC")
			VAR HunterPopulation = CALCULATE(SUM(SA4_Summary[resident_population]), REMOVEFILTERS(), SA4_Summary[sa4_code] = "106")
			VAR NSWPopulation = CALCULATE(SUM(SA4_Summary[resident_population]), REMOVEFILTERS())
			VAR HunterRate = DIVIDE(HunterDC * 10000, HunterPopulation)
			VAR NSWRate = DIVIDE(NSWDC * 10000, NSWPopulation)
			RETURN FORMAT(HunterRate, "0.00") & " DC / 10k residents; " & FORMAT(DIVIDE(HunterRate, NSWRate), "0.0%") & " of NSW rate"
		displayFolder: Findings
		lineageTag: 7c663c5e-1218-485c-9685-44ac3567f5f1

	measure 'Finding - Sydney DC Gap' =
			VAR SydneyLocations = CALCULATE([Existing Locations], REMOVEFILTERS(), EV_Locations[gcc_name] = "Greater Sydney")
			VAR SydneyDC = CALCULATE([Existing Locations], REMOVEFILTERS(), EV_Locations[gcc_name] = "Greater Sydney", EV_Locations[charger_type] = "DC")
			VAR RestLocations = CALCULATE([Existing Locations], REMOVEFILTERS(), EV_Locations[gcc_name] = "Rest of NSW")
			VAR RestDC = CALCULATE([Existing Locations], REMOVEFILTERS(), EV_Locations[gcc_name] = "Rest of NSW", EV_Locations[charger_type] = "DC")
			VAR SydneyShare = DIVIDE(SydneyDC, SydneyLocations)
			VAR RestShare = DIVIDE(RestDC, RestLocations)
			RETURN "DC share: Sydney " & FORMAT(SydneyShare, "0.0%") & " vs rest " & FORMAT(RestShare, "0.0%") & "; " & FORMAT((SydneyShare - RestShare) * 100, "0.0") & " pp gap"
		displayFolder: Findings
		lineageTag: 86785b64-f105-410a-a954-a1dbf5399b2d

	measure 'Finding - Top Three Operators' =
			VAR Operators = CALCULATETABLE(ADDCOLUMNS(VALUES(Operator_Summary[operator_name]), "Locations", [Existing Locations]), REMOVEFILTERS())
			VAR Leaders = TOPN(3, Operators, [Locations], DESC, Operator_Summary[operator_name], ASC)
			VAR TotalExisting = CALCULATE([Existing Locations], REMOVEFILTERS())
			RETURN CONCATENATEX(Leaders, Operator_Summary[operator_name], ", ", [Locations], DESC) & ": " & FORMAT(DIVIDE(SUMX(Leaders, [Locations]), TotalExisting), "0.0%") & " of existing locations"
		displayFolder: Findings
		lineageTag: c6a63b38-4b58-4b84-9483-24c523844c86

